---
import type { CollectionEntry } from 'astro:content';

interface Props {
  recipe: CollectionEntry<'recipes'>;
  /** Animation stagger index */
  index?: number;
}

const { recipe, index = 0 } = Astro.props;
const { data, slug } = recipe;
const totalTime = data.prepTime + data.cookTime;
const delay = Math.min(index, 8) * 60;
---

<a
  href={`/recipes/${slug}`}
  class="group flex flex-col overflow-hidden rounded-xl2 border border-line bg-card shadow-card transition-all duration-200 hover:-translate-y-1 hover:border-accent/60 hover:shadow-card-hover animate-fade-up"
  style={`animation-delay:${delay}ms`}
  data-subcategory={data.subcategory}
  data-budget-filters={data.budgetFilters.join('|')}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-coal-2">
    <img
      src={data.image}
      alt={data.imageAlt || data.title}
      loading="lazy"
      decoding="async"
      width="640"
      height="480"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <span class="absolute left-3 top-3 rounded-md bg-header/85 px-2.5 py-1 font-heading text-sm font-600 uppercase tracking-wide text-accent backdrop-blur">
      {data.category}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <h3 class="font-heading text-2xl font-700 uppercase leading-tight tracking-tight text-ink transition-colors group-hover:text-accent">
      {data.title}
    </h3>
    <p class="mt-1.5 line-clamp-2 text-sm text-muted">{data.description}</p>

    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-4 text-sm text-muted">
      <span class="inline-flex items-center gap-1.5">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        {totalTime} min
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h16M4 12a8 8 0 0 1 16 0M6 16h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        {data.servings} servings
      </span>
      <span class="font-600 text-ink">{data.macros.protein}g protein</span>
    </div>
  </div>
</a>
