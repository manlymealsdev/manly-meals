---
import { amazonSearch } from '../data/gear';

interface Props {
  gear: { name: string; note: string }[];
}
const { gear } = Astro.props;
// Fallback to a sensible default kit if a recipe lists none.
const items =
  gear.length > 0
    ? gear
    : [
        { name: "8-inch Chef's Knife", note: 'Does almost everything.' },
        { name: '12-inch Cast Iron Skillet', note: 'Sears and bakes.' },
        { name: 'Instant-Read Thermometer', note: 'Stop guessing on meat.' },
      ];
---

<section class="mt-12 rounded-xl2 border border-line bg-card p-5 sm:p-6">
  <div class="flex items-center gap-2">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6a1.5 1.5 0 0 0 2.1 2.1l6-6a4 4 0 0 0 5.4-5.4l-2.3 2.3-2.1-2.1 2.3-2.3Z" stroke="#BE6600" stroke-width="2" stroke-linejoin="round"/>
    </svg>
    <h2 class="font-display text-2xl uppercase tracking-wide text-ink">Tools You'll Need</h2>
  </div>

  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {items.map((g) => (
      <li class="flex items-start justify-between gap-3 rounded-lg border border-line bg-coal-2 p-3">
        <div>
          <p class="font-heading text-lg font-600 uppercase tracking-wide text-ink">{g.name}</p>
          {g.note && <p class="text-sm text-muted">{g.note}</p>}
        </div>
        <a
          href={amazonSearch(g.name)}
          rel="nofollow sponsored noopener"
          target="_blank"
          class="shrink-0 self-center rounded-md bg-accent px-3 py-2 font-heading text-sm font-700 uppercase tracking-wide text-coal transition-colors hover:bg-accent-bright"
        >
          Shop
        </a>
      </li>
    ))}
  </ul>
</section>
