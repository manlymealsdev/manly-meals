---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="That page isn't on the menu.">
  <section class="container-mm flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <p class="font-display text-7xl uppercase tracking-wide text-accent sm:text-9xl">404</p>
    <h1 class="mt-2 font-display text-3xl uppercase tracking-wide text-ink sm:text-4xl">
      That page isn't on the menu
    </h1>
    <p class="mt-3 max-w-md text-lg text-muted">
      The recipe you're after moved or never existed. Let's get you back to dinner.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-accent">Home</a>
      <a href="/budget-meals" class="btn-ghost">Cheap eats</a>
    </div>
  </section>
</BaseLayout>
