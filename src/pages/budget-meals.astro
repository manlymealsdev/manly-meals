---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getCategory } from '../data/categories';

const category = getCategory('/budget-meals')!;
const filters = category.filters ?? [];

const all = await getCollection('recipes');
const recipes = all
  .filter((r) => r.data.category === 'Budget Meals' || r.data.sections.includes('Budget Meals'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const count = recipes.length;
---

<BaseLayout
  title="Budget Meals"
  description="Cheap meals that actually fill you up. Feed yourself for the price of a coffee."
>
  <section class="border-b border-line bg-coal-2">
    <div class="container-mm py-10 sm:py-14">
      <p class="eyebrow">{count} cheap {count === 1 ? 'meal' : 'meals'}</p>
      <h1 class="mt-2 font-display text-5xl uppercase leading-none tracking-tight text-ink sm:text-7xl">
        Budget Meals
      </h1>
      <p class="mt-3 max-w-prose text-lg text-muted">{category.blurb}</p>
    </div>
  </section>

  <div class="container-mm py-10">
    <!-- Top filter buttons -->
    <div class="no-scrollbar -mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
      <div class="flex min-w-max gap-2 sm:flex-wrap" data-filter-group>
        <button type="button" data-filter="__all" data-active
          class="min-h-[48px] whitespace-nowrap rounded-lg border border-line bg-card px-5 py-2.5 font-heading text-lg font-600 uppercase tracking-wide text-ink transition-all hover:border-accent data-[active]:border-accent data-[active]:bg-accent data-[active]:text-coal">
          All
        </button>
        {filters.map((f) => (
          <button type="button" data-filter={f}
            class="min-h-[48px] whitespace-nowrap rounded-lg border border-line bg-card px-5 py-2.5 font-heading text-lg font-600 uppercase tracking-wide text-ink transition-all hover:border-accent data-[active]:border-accent data-[active]:bg-accent data-[active]:text-coal">
            {f}
          </button>
        ))}
      </div>
    </div>

    <!-- Recipe grid -->
    <div class="mt-8">
      {count === 0 ? (
        <p class="rounded-xl2 border border-dashed border-line bg-card p-8 text-center text-muted">No budget recipes yet.</p>
      ) : (
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-recipe-grid>
          {recipes.map((recipe, i) => <RecipeCard recipe={recipe} index={i} />)}
        </div>
      )}
      <p class="mt-6 hidden text-center text-muted" data-empty-filter>
        Nothing in that group yet. Tap <strong class="text-accent">All</strong> to see everything.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const group = document.querySelector<HTMLElement>('[data-filter-group]');
  const grid = document.querySelector<HTMLElement>('[data-recipe-grid]');
  const emptyMsg = document.querySelector<HTMLElement>('[data-empty-filter]');

  if (group && grid) {
    const buttons = group.querySelectorAll<HTMLButtonElement>('button[data-filter]');
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-budget-filters]'));

    function applyFilter(filter: string) {
      let visible = 0;
      cards.forEach((card) => {
        const tags = (card.dataset.budgetFilters || '').split('|').filter(Boolean);
        const show = filter === '__all' || tags.includes(filter);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (emptyMsg) emptyMsg.style.display = visible === 0 ? 'block' : 'none';
      buttons.forEach((b) => b.toggleAttribute('data-active', b.dataset.filter === filter));
    }

    buttons.forEach((b) => b.addEventListener('click', () => applyFilter(b.dataset.filter || '__all')));
  }
</script>
